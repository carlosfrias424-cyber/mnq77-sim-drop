//@version=5
indicator("MNQ Official Rails v2.2", overlay=true, max_lines_count=500, max_labels_count=64)

watchPts = input.float(10.0, "Alert distance (pts)", minval=1.0, step=0.25)
mergePts = input.float(40.0, "Merge whole book closer than (pts)", minval=2.0, step=1.0)
swingL   = input.int(2, "Swing left", minval=1, maxval=8)
swingR   = input.int(2, "Swing right", minval=1, maxval=8)
maxH4    = input.int(12, "Keep N recent 4H highs / lows", minval=2, maxval=40)
maxH1    = input.int(16, "Keep N recent 1H highs / lows", minval=2, maxval=80)
maxMaj   = input.int(8, "Keep N major H4 extremes (never age out)", minval=2, maxval=16)
showEma  = input.bool(false, "Draw 1H EMA 15/50")
tz       = "America/Chicago"
rthSess  = "0830-1500"

colH4  = color.new(#1e88e5, 0)
colH1  = color.new(#2e7d32, 0)
colDay = color.new(#90caf9, 0)
colWk  = color.new(#ef6c00, 0)
colOn  = color.new(#78909c, 0)
colOp  = color.new(#eceff1, 0)
colEma = color.new(#9e9e9e, 60)

jsonMsg(kind, px, tf) =>
    '{"secret":"","symbol":"' + syminfo.ticker + '","event":"poi","poi_name":"' + kind + '","type":"' + kind + '","tf":"' + tf + '","price":' + str.tostring(px, "#.00") + ',"ts":' + str.tostring(time) + ',"src":"official_rails_v2"}'

f_rth_open() =>
    var float o = na
    inR = not na(time(timeframe.period, rthSess, tz))
    if ta.change(time("D", tz)) != 0
        o := na
    if inR and na(o)
        o := open
    o

f_on_high() =>
    var float h = na
    inR = not na(time(timeframe.period, rthSess, tz))
    if ta.change(time("D", tz)) != 0
        h := na
    if not inR
        h := na(h) ? high : math.max(h, high)
    h

f_on_low() =>
    var float l = na
    inR = not na(time(timeframe.period, rthSess, tz))
    if ta.change(time("D", tz)) != 0
        l := na
    if not inR
        l := na(l) ? low : math.min(l, low)
    l

f_pdh() =>
    var float cur = na
    var float prev = na
    inR = not na(time(timeframe.period, rthSess, tz))
    if ta.change(time("D", tz)) != 0
        prev := cur
        cur := na
    if inR
        cur := na(cur) ? high : math.max(cur, high)
    prev

f_pdl() =>
    var float cur = na
    var float prev = na
    inR = not na(time(timeframe.period, rthSess, tz))
    if ta.change(time("D", tz)) != 0
        prev := cur
        cur := na
    if inR
        cur := na(cur) ? low : math.min(cur, low)
    prev

nearArr(a, px) =>
    hit = false
    if not na(px) and array.size(a) > 0
        for i = 0 to array.size(a) - 1
            if math.abs(array.get(a, i) - px) <= mergePts
                hit := true
    hit

pack12(a) =>
    n = array.size(a)
    [n > 0 ? array.get(a, 0) : na, n > 1 ? array.get(a, 1) : na, n > 2 ? array.get(a, 2) : na, n > 3 ? array.get(a, 3) : na, n > 4 ? array.get(a, 4) : na, n > 5 ? array.get(a, 5) : na, n > 6 ? array.get(a, 6) : na, n > 7 ? array.get(a, 7) : na, n > 8 ? array.get(a, 8) : na, n > 9 ? array.get(a, 9) : na, n > 10 ? array.get(a, 10) : na, n > 11 ? array.get(a, 11) : na]

pack16(a) =>
    n = array.size(a)
    [n > 0 ? array.get(a, 0) : na, n > 1 ? array.get(a, 1) : na, n > 2 ? array.get(a, 2) : na, n > 3 ? array.get(a, 3) : na, n > 4 ? array.get(a, 4) : na, n > 5 ? array.get(a, 5) : na, n > 6 ? array.get(a, 6) : na, n > 7 ? array.get(a, 7) : na, n > 8 ? array.get(a, 8) : na, n > 9 ? array.get(a, 9) : na, n > 10 ? array.get(a, 10) : na, n > 11 ? array.get(a, 11) : na, n > 12 ? array.get(a, 12) : na, n > 13 ? array.get(a, 13) : na, n > 14 ? array.get(a, 14) : na, n > 15 ? array.get(a, 15) : na]

pack8(a) =>
    n = array.size(a)
    [n > 0 ? array.get(a, 0) : na, n > 1 ? array.get(a, 1) : na, n > 2 ? array.get(a, 2) : na, n > 3 ? array.get(a, 3) : na, n > 4 ? array.get(a, 4) : na, n > 5 ? array.get(a, 5) : na, n > 6 ? array.get(a, 6) : na, n > 7 ? array.get(a, 7) : na]

f_h4_highs() =>
    var float[] a = array.new_float()
    ph = ta.pivothigh(high, swingL, swingR)
    if not na(ph) and not nearArr(a, ph)
        array.push(a, ph)
        if array.size(a) > maxH4
            array.shift(a)
    pack12(a)

f_h4_lows() =>
    var float[] a = array.new_float()
    pl = ta.pivotlow(low, swingL, swingR)
    if not na(pl) and not nearArr(a, pl)
        array.push(a, pl)
        if array.size(a) > maxH4
            array.shift(a)
    pack12(a)

f_h1_highs() =>
    var float[] a = array.new_float()
    ph = ta.pivothigh(high, swingL, swingR)
    if not na(ph) and not nearArr(a, ph)
        array.push(a, ph)
        if array.size(a) > maxH1
            array.shift(a)
    pack16(a)

f_h1_lows() =>
    var float[] a = array.new_float()
    pl = ta.pivotlow(low, swingL, swingR)
    if not na(pl) and not nearArr(a, pl)
        array.push(a, pl)
        if array.size(a) > maxH1
            array.shift(a)
    pack16(a)

f_maj_highs() =>
    var float[] a = array.new_float()
    ph = ta.pivothigh(high, swingL, swingR)
    if not na(ph) and not nearArr(a, ph)
        array.push(a, ph)
        array.sort(a, order.descending)
        while array.size(a) > maxMaj
            array.pop(a)
    pack8(a)

f_maj_lows() =>
    var float[] a = array.new_float()
    pl = ta.pivotlow(low, swingL, swingR)
    if not na(pl) and not nearArr(a, pl)
        array.push(a, pl)
        array.sort(a, order.ascending)
        while array.size(a) > maxMaj
            array.pop(a)
    pack8(a)

look = barmerge.lookahead_off
[h4h0, h4h1, h4h2, h4h3, h4h4, h4h5, h4h6, h4h7, h4h8, h4h9, h4h10, h4h11] = request.security(syminfo.tickerid, "240", f_h4_highs(), lookahead=look)
[h4l0, h4l1, h4l2, h4l3, h4l4, h4l5, h4l6, h4l7, h4l8, h4l9, h4l10, h4l11] = request.security(syminfo.tickerid, "240", f_h4_lows(), lookahead=look)
[mh0, mh1, mh2, mh3, mh4, mh5, mh6, mh7] = request.security(syminfo.tickerid, "240", f_maj_highs(), lookahead=look)
[ml0, ml1, ml2, ml3, ml4, ml5, ml6, ml7] = request.security(syminfo.tickerid, "240", f_maj_lows(), lookahead=look)
[h1h0, h1h1, h1h2, h1h3, h1h4, h1h5, h1h6, h1h7, h1h8, h1h9, h1h10, h1h11, h1h12, h1h13, h1h14, h1h15] = request.security(syminfo.tickerid, "60", f_h1_highs(), lookahead=look)
[h1l0, h1l1, h1l2, h1l3, h1l4, h1l5, h1l6, h1l7, h1l8, h1l9, h1l10, h1l11, h1l12, h1l13, h1l14, h1l15] = request.security(syminfo.tickerid, "60", f_h1_lows(), lookahead=look)
ema50   = request.security(syminfo.tickerid, "60",  ta.ema(close, 50), lookahead=look)
ema15   = request.security(syminfo.tickerid, "60",  ta.ema(close, 15), lookahead=look)
pwh     = request.security(syminfo.tickerid, "W",   high[1], lookahead=look)
pwl     = request.security(syminfo.tickerid, "W",   low[1],  lookahead=look)
px1     = request.security(syminfo.tickerid, "1",   close,   lookahead=look)
rthOpen = request.security(syminfo.tickerid, "1",   f_rth_open(), lookahead=look)
pdh     = request.security(syminfo.tickerid, "1",   f_pdh(), lookahead=look)
pdl     = request.security(syminfo.tickerid, "1",   f_pdl(), lookahead=look)
onh     = request.security(syminfo.tickerid, "1",   f_on_high(), lookahead=look)
onl     = request.security(syminfo.tickerid, "1",   f_on_low(), lookahead=look)

takenNear(book, px) =>
    hit = false
    if not na(px) and array.size(book) > 0
        for i = 0 to array.size(book) - 1
            if math.abs(array.get(book, i) - px) <= mergePts
                hit := true
    hit

var float[] visPx = array.new_float()
var string[] visKind = array.new_string()
var string[] visTf = array.new_string()
var line[] visLn = array.new_line()
var label[] visLb = array.new_label()
var float[] lockPx = array.new_float()
var string[] lockKind = array.new_string()
var string[] lockTf = array.new_string()
var int lockDay = na

colOf(kind) =>
    kind == "H4H" or kind == "H4L" ? colH4 : kind == "H1H" or kind == "H1L" ? colH1 : kind == "PWH" or kind == "PWL" ? colWk : kind == "OPEN" ? colOp : kind == "ONH" or kind == "ONL" ? colOn : kind == "EMA50" or kind == "EMA15" ? colEma : colDay

tryAdd(kind, px, tf) =>
    ok = false
    if not na(px) and not takenNear(visPx, px)
        array.push(visPx, px)
        array.push(visKind, kind)
        array.push(visTf, tf)
        ok := true
    ok

copyToLock() =>
    array.clear(lockPx)
    array.clear(lockKind)
    array.clear(lockTf)
    if array.size(visPx) > 0
        for i = 0 to array.size(visPx) - 1
            array.push(lockPx, array.get(visPx, i))
            array.push(lockKind, array.get(visKind, i))
            array.push(lockTf, array.get(visTf, i))

loadFromLock() =>
    array.clear(visPx)
    array.clear(visKind)
    array.clear(visTf)
    if array.size(lockPx) > 0
        for i = 0 to array.size(lockPx) - 1
            array.push(visPx, array.get(lockPx, i))
            array.push(visKind, array.get(lockKind, i))
            array.push(visTf, array.get(lockTf, i))

fillLive() =>
    array.clear(visPx)
    array.clear(visKind)
    array.clear(visTf)
    tryAdd("H4H", mh0, "240")
    tryAdd("H4H", mh1, "240")
    tryAdd("H4H", mh2, "240")
    tryAdd("H4H", mh3, "240")
    tryAdd("H4H", mh4, "240")
    tryAdd("H4H", mh5, "240")
    tryAdd("H4H", mh6, "240")
    tryAdd("H4H", mh7, "240")
    tryAdd("H4L", ml0, "240")
    tryAdd("H4L", ml1, "240")
    tryAdd("H4L", ml2, "240")
    tryAdd("H4L", ml3, "240")
    tryAdd("H4L", ml4, "240")
    tryAdd("H4L", ml5, "240")
    tryAdd("H4L", ml6, "240")
    tryAdd("H4L", ml7, "240")
    tryAdd("H4H", h4h0, "240")
    tryAdd("H4H", h4h1, "240")
    tryAdd("H4H", h4h2, "240")
    tryAdd("H4H", h4h3, "240")
    tryAdd("H4H", h4h4, "240")
    tryAdd("H4H", h4h5, "240")
    tryAdd("H4H", h4h6, "240")
    tryAdd("H4H", h4h7, "240")
    tryAdd("H4H", h4h8, "240")
    tryAdd("H4H", h4h9, "240")
    tryAdd("H4H", h4h10, "240")
    tryAdd("H4H", h4h11, "240")
    tryAdd("H4L", h4l0, "240")
    tryAdd("H4L", h4l1, "240")
    tryAdd("H4L", h4l2, "240")
    tryAdd("H4L", h4l3, "240")
    tryAdd("H4L", h4l4, "240")
    tryAdd("H4L", h4l5, "240")
    tryAdd("H4L", h4l6, "240")
    tryAdd("H4L", h4l7, "240")
    tryAdd("H4L", h4l8, "240")
    tryAdd("H4L", h4l9, "240")
    tryAdd("H4L", h4l10, "240")
    tryAdd("H4L", h4l11, "240")
    tryAdd("PDH", pdh, "D")
    tryAdd("PDL", pdl, "D")
    tryAdd("PWH", pwh, "W")
    tryAdd("PWL", pwl, "W")
    tryAdd("OPEN", rthOpen, "D")
    tryAdd("ONH", onh, "ON")
    tryAdd("ONL", onl, "ON")
    tryAdd("H1H", h1h0, "60")
    tryAdd("H1H", h1h1, "60")
    tryAdd("H1H", h1h2, "60")
    tryAdd("H1H", h1h3, "60")
    tryAdd("H1H", h1h4, "60")
    tryAdd("H1H", h1h5, "60")
    tryAdd("H1H", h1h6, "60")
    tryAdd("H1H", h1h7, "60")
    tryAdd("H1H", h1h8, "60")
    tryAdd("H1H", h1h9, "60")
    tryAdd("H1H", h1h10, "60")
    tryAdd("H1H", h1h11, "60")
    tryAdd("H1H", h1h12, "60")
    tryAdd("H1H", h1h13, "60")
    tryAdd("H1H", h1h14, "60")
    tryAdd("H1H", h1h15, "60")
    tryAdd("H1L", h1l0, "60")
    tryAdd("H1L", h1l1, "60")
    tryAdd("H1L", h1l2, "60")
    tryAdd("H1L", h1l3, "60")
    tryAdd("H1L", h1l4, "60")
    tryAdd("H1L", h1l5, "60")
    tryAdd("H1L", h1l6, "60")
    tryAdd("H1L", h1l7, "60")
    tryAdd("H1L", h1l8, "60")
    tryAdd("H1L", h1l9, "60")
    tryAdd("H1L", h1l10, "60")
    tryAdd("H1L", h1l11, "60")
    tryAdd("H1L", h1l12, "60")
    tryAdd("H1L", h1l13, "60")
    tryAdd("H1L", h1l14, "60")
    tryAdd("H1L", h1l15, "60")
    if showEma
        tryAdd("EMA50", ema50, "60")
        tryAdd("EMA15", ema15, "60")

if barstate.islast
    sessId = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    hChi = hour(time, tz)
    locked = hChi >= 4 and not na(lockDay) and lockDay == sessId and array.size(lockPx) > 0
    if locked
        loadFromLock()
        if not na(rthOpen) and not takenNear(visPx, rthOpen)
            tryAdd("OPEN", rthOpen, "D")
            array.push(lockPx, rthOpen)
            array.push(lockKind, "OPEN")
            array.push(lockTf, "D")
    else
        fillLive()
        if hChi >= 4
            copyToLock()
            lockDay := sessId
    while array.size(visLn) > array.size(visPx)
        line.delete(array.pop(visLn))
        label.delete(array.pop(visLb))
    while array.size(visLn) < array.size(visPx)
        array.push(visLn, line.new(bar_index, close, bar_index + 1, close, extend=extend.both, color=colH4, width=1))
        array.push(visLb, label.new(bar_index, close, "", xloc.bar_index, yloc.price, color.new(colH4, 70), label.style_label_left, color.white, size.tiny))
    if array.size(visPx) > 0
        for i = 0 to array.size(visPx) - 1
            px = array.get(visPx, i)
            kind = array.get(visKind, i)
            ln = array.get(visLn, i)
            lb = array.get(visLb, i)
            c = colOf(kind)
            line.set_xy1(ln, bar_index - 1, px)
            line.set_xy2(ln, bar_index, px)
            line.set_extend(ln, extend.both)
            line.set_color(ln, c)
            line.set_width(ln, kind == "H4H" or kind == "H4L" ? 4 : kind == "H1H" or kind == "H1L" ? 2 : 1)
            label.set_xy(lb, bar_index, px)
            label.set_text(lb, kind + " " + str.tostring(px, "#.00"))
            label.set_color(lb, color.new(c, 40))
            label.set_textcolor(lb, c)

if barstate.islast and array.size(visPx) > 0
    for i = 0 to array.size(visPx) - 1
        px = array.get(visPx, i)
        if not na(px1) and math.abs(px1 - px) <= watchPts
            alert(jsonMsg(array.get(visKind, i), px, array.get(visTf, i)), alert.freq_once_per_bar)
