[Unit]
Description=MNQ 7/7 BE+20 manager (SIM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/administrator/.openclaw/workspace/mnq_hybrid
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/administrator/.openclaw/workspace/mnq_hybrid/.venv/bin/python -u /home/administrator/.openclaw/workspace/mnq_hybrid/apps/tradovate/manage_be20.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/manage_be20.out
StandardError=append:/tmp/manage_be20.out

[Install]
WantedBy=default.target
